# Required: your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# Optional: the model to run. Uncomment to override the default (gpt-6-luna).
# OPENAI_MODEL=gpt-6-luna
# Optional: only if you switch the example to Browserbase (https://www.browserbase.com)
BROWSERBASE_API_KEY=
